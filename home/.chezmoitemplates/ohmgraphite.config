<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="type" value="{{ .windows.ohmgraphite.type }}" />
    <add key="influx2_address" value="{{ .windows.ohmgraphite.influx2.address }}" />
    <add key="influx2_org" value="{{ .windows.ohmgraphite.influx2.org }}" />
    <add key="influx2_bucket" value="{{ .windows.ohmgraphite.influx2.bucket }}" />
    <add key="influx2_token" value="%{{ .windows.ohmgraphite.token_var }}%" />
    <add key="interval" value="{{ .windows.ohmgraphite.interval }}" />
  </appSettings>
</configuration>
