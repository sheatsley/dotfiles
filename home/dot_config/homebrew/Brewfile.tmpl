{{- /*
  This file generates ~/.config/homebrew/Brewfile from .chezmoidata/packages.yaml:
  the taps, then the packages common to every Mac, then the packages for this
  machine (.machine, chosen at `chezmoi init`). It replaces the
  Brewfile##hostname.* alternates that yadm used. A tap marked signed is
  trusted as a whole (Homebrew 6 ignores packages from untrusted non-official
  taps, and brew bundle cleanup resets the trust to what this file declares);
  the brew bundle script checks its signature before brew bundle reads this.
*/ -}}
{{- $sets := list .packages.common (index .packages .machine) -}}
{{- range .packages.taps -}}
tap {{ .name | quote }}{{ if index . "signed" }}, trusted: true{{ end }}
{{ end -}}
{{- range $sets -}}
{{-   range .brews -}}
# {{ .desc }}
brew {{ .name | quote }}
{{ end -}}
{{- end -}}
{{- range $sets -}}
{{-   range .casks -}}
# {{ .desc }}
cask {{ .name | quote }}
{{ end -}}
{{- end -}}
{{- range $sets -}}
{{-   range .mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}
{{- end -}}
