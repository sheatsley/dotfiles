{{ template "ps-prelude.ps1" . }}

<#
This script sets the pinned apps on the taskbar, in the order given by taskbar
in .chezmoidata/windows.yaml (Windows always puts the Start button first). It
uses Microsoft's taskbar layout file: this script writes the layout to
C:\ProgramData\dotfiles\TaskbarLayout.xml and points the Start layout policy at
it, and Explorer applies it at the next sign-in. The layout replaces the default
pins, so only the listed apps are pinned (apps you pin yourself later are kept).
Each wanted app is found by looking for its Start menu shortcut (desktop apps)
and then for a packaged app of that name (Store apps). Windows shows a second
icon when a running app's windows do not carry the same app user model ID
(AUMID) as the pinned shortcut: an app can declare its own ID on its windows
(Steam does, as Valve.Steam.Client), a shortcut can carry an ID the windows lack
(the NVIDIA app's Start shortcut does), and a launcher can start a different
program than the shortcut points to (Battle.net does). For those apps,
rebuild: true in windows.yaml pins a fresh copy of the shortcut, made here in
C:\ProgramData\dotfiles\Pins, that has no ID unless aumid gives one and points
at target if that is given (found with diagnose-taskbar.ps1). An app with no Start
menu shortcut at all (Airfoil Satellite) is listed by name and path instead,
and its shortcut is made the same way. An app that is not
installed yet cannot be pinned, because Windows drops a pin it cannot resolve
instead of leaving a placeholder; it is pinned in its place by the first apply
after it is installed (and the next sign-in). Windows may honor this policy only
on some editions. It requires an elevated session.
#>
Assert-Admin

$items = @(
{{- range .windows.taskbar }}
    @{ Id = {{ with index . "id" }}{{ squote . }}{{ else }}''{{ end }}; Match = {{ with index . "match" }}{{ squote . }}{{ else }}''{{ end }}; Rebuild = {{ if index . "rebuild" }}$true{{ else }}$false{{ end }}; Aumid = {{ with index . "aumid" }}{{ squote . }}{{ else }}''{{ end }}; Target = {{ with index . "target" }}{{ squote . }}{{ else }}''{{ end }}; Name = {{ with index . "name" }}{{ squote . }}{{ else }}''{{ end }}; Path = {{ with index . "path" }}{{ squote . }}{{ else }}''{{ end }} }
{{- end }}
)

function Find-StartLink {
    <#
    This function looks for a Start menu shortcut by name. When several match
    (for example a 32-bit and a 64-bit shortcut), a 64-bit one is preferred,
    then the shortest name (so "Steam" wins over "Steam Support").

    :param Pattern: a wildcard pattern for the shortcut name
    :return: the full path of the shortcut, or nothing if there is none
    #>
    param([string]$Pattern)
    $roots = @(
        (Join-Path $env:ProgramData 'Microsoft\Windows\Start Menu\Programs'),
        (Join-Path $env:APPDATA 'Microsoft\Windows\Start Menu\Programs')
    )
    $hit = foreach ($root in $roots) {
        if (Test-Path -LiteralPath $root) {
            Get-ChildItem -LiteralPath $root -Recurse -Filter '*.lnk' -File -ErrorAction SilentlyContinue |
                Where-Object { $_.BaseName -like $Pattern -and $_.BaseName -notmatch 'uninstall' }
        }
    }
    $best = $hit | Sort-Object { $_.BaseName -notmatch '64' }, { $_.BaseName.Length } | Select-Object -First 1
    if ($best) { return $best.FullName }
    return $null
}

if (-not ('PinAumid' -as [type])) {
    Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;

public static class PinAumid
{
    [StructLayout(LayoutKind.Sequential, Pack = 4)]
    public struct PROPERTYKEY
    {
        public Guid fmtid;
        public uint pid;
    }

    [ComImport, Guid("886D8EEB-8CF2-4446-8D02-CDBA1DBDCF99"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
    public interface IPropertyStore
    {
        int GetCount(out uint count);
        int GetAt(uint index, out PROPERTYKEY key);
        int GetValue(ref PROPERTYKEY key, IntPtr value);
        int SetValue(ref PROPERTYKEY key, IntPtr value);
        int Commit();
    }

    [DllImport("shell32.dll", CharSet = CharSet.Unicode)]
    static extern int SHGetPropertyStoreFromParsingName(string path, IntPtr bindContext, int flags, ref Guid riid, out IPropertyStore store);
    [DllImport("ole32.dll")]
    static extern int PropVariantClear(IntPtr value);

    // writes System.AppUserModel.ID (the app user model ID) onto a shortcut file
    public static void Set(string path, string aumid)
    {
        Guid iid = new Guid("886D8EEB-8CF2-4446-8D02-CDBA1DBDCF99");
        IPropertyStore store;
        int hr = SHGetPropertyStoreFromParsingName(path, IntPtr.Zero, 2, ref iid, out store);
        if (hr != 0) { throw new InvalidOperationException("could not open " + path + " (0x" + hr.ToString("X") + ")"); }
        PROPERTYKEY key = new PROPERTYKEY();
        key.fmtid = new Guid("9F4C2855-9F79-4B39-A8D0-E1D42DE1D5F3");
        key.pid = 5;
        IntPtr value = Marshal.AllocCoTaskMem(24);
        try
        {
            for (int i = 0; i < 24; i++) { Marshal.WriteByte(value, i, 0); }
            // 31 is VT_LPWSTR; the string pointer sits after the 8-byte header
            Marshal.WriteInt16(value, 31);
            Marshal.WriteIntPtr(value, 8, Marshal.StringToCoTaskMemUni(aumid));
            hr = store.SetValue(ref key, value);
            if (hr != 0) { throw new InvalidOperationException("could not set the app ID (0x" + hr.ToString("X") + ")"); }
            hr = store.Commit();
            if (hr != 0) { throw new InvalidOperationException("could not save the app ID (0x" + hr.ToString("X") + ")"); }
            PropVariantClear(value);
        }
        finally
        {
            Marshal.FreeCoTaskMem(value);
        }
    }
}
'@
}

function New-PinShortcut {
    <#
    This function makes a fresh copy of a Start menu shortcut to pin: same
    program, arguments, and icon, but with no app ID unless one is given, and
    optionally pointing at another program. Starting from a new file matters,
    because a shortcut keeps the app ID it already has.

    :param Source: the Start menu shortcut to copy (empty when Exe is given)
    :param Aumid: the app ID to put on the copy (empty for none)
    :param TargetGlob: a wildcard path to point the copy at (empty to keep the original program)
    :param Exe: a program to make a shortcut to, for apps with no Start menu shortcut
    :param Name: the shortcut's name when Exe is given
    :return: the full path of the new shortcut
    #>
    param([string]$Source, [string]$Aumid, [string]$TargetGlob, [string]$Exe, [string]$Name)
    $wsh = New-Object -ComObject WScript.Shell
    if ($Exe) {
        $target = $Exe
        $folder = Split-Path -Parent $Exe
        $icon = ''
        $arguments = ''
        $leaf = "$Name.lnk"
    } else {
        $from = $wsh.CreateShortcut($Source)
        $target = $from.TargetPath
        $folder = $from.WorkingDirectory
        $icon = $from.IconLocation
        $arguments = $from.Arguments
        $leaf = Split-Path -Leaf $Source
    }
    if ($TargetGlob) {
        $found = Get-ChildItem -Path $TargetGlob -File -ErrorAction SilentlyContinue |
            Sort-Object LastWriteTime -Descending | Select-Object -First 1
        if ($found) {
            $target = $found.FullName
            $folder = $found.DirectoryName
            $icon = ''
        } else {
            Write-Warning "Nothing matches '$TargetGlob'; the copy keeps pointing at $target"
        }
    }
    if (-not $icon -or $icon -match '^,') { $icon = "$target,0" }

    $dir = Join-Path $env:ProgramData 'dotfiles\Pins'
    New-Item -ItemType Directory -Force -Path $dir | Out-Null
    $path = Join-Path $dir $leaf
    if (Test-Path -LiteralPath $path) { Remove-Item -LiteralPath $path -Force }
    $to = $wsh.CreateShortcut($path)
    $to.TargetPath = $target
    $to.Arguments = $arguments
    $to.WorkingDirectory = $folder
    $to.IconLocation = $icon
    $to.Save()
    if ($Aumid) { [PinAumid]::Set($path, $Aumid) }
    return $path
}

function Find-PackagedApp {
    <#
    This function looks for a packaged (Store) app by its Start menu name.

    :param Pattern: a wildcard pattern for the app name
    :return: the app user model ID, or nothing if there is none
    #>
    param([string]$Pattern)
    $hit = Get-StartApps | Where-Object { $_.Name -like $Pattern -and $_.AppID -like '*!*' } |
        Sort-Object { $_.Name.Length } | Select-Object -First 1
    if ($hit) { return $hit.AppID }
    return $null
}

# build the list of pins, in order
$pins = @()
foreach ($item in $items) {
    if ($item.Id) {
        $pins += ('        <taskbar:DesktopApp DesktopApplicationID="{0}"/>' -f $item.Id)
        continue
    }
    if ($item.Path) {
        if (Test-Path -LiteralPath $item.Path) {
            $link = New-PinShortcut -Exe $item.Path -Name $item.Name -Aumid $item.Aumid
            $pins += ('        <taskbar:DesktopApp DesktopApplicationLinkPath="{0}"/>' -f [Security.SecurityElement]::Escape($link))
            Write-Step "pin  $($item.Name) -> $($item.Path)"
        } else {
            Write-Warning "Not pinned yet: $($item.Path) does not exist ($($item.Name) is not installed)"
        }
        continue
    }
    $link = Find-StartLink $item.Match
    if ($link -and $item.Rebuild) {
        $link = New-PinShortcut $link $item.Aumid $item.Target
    }
    if ($link) {
        $pins += ('        <taskbar:DesktopApp DesktopApplicationLinkPath="{0}"/>' -f [Security.SecurityElement]::Escape($link))
        Write-Step "pin  $($item.Match) -> $link"
        continue
    }
    $aumid = Find-PackagedApp $item.Match
    if ($aumid) {
        $pins += ('        <taskbar:UWA AppUserModelID="{0}"/>' -f [Security.SecurityElement]::Escape($aumid))
        Write-Step "pin  $($item.Match) -> $aumid"
        continue
    }
    Write-Warning "Not pinned yet: nothing installed matches '$($item.Match)'"
}

# assemble the layout file
$xml = @'
<?xml version="1.0" encoding="utf-8"?>
<LayoutModificationTemplate
    xmlns="http://schemas.microsoft.com/Start/2014/LayoutModification"
    xmlns:defaultlayout="http://schemas.microsoft.com/Start/2014/FullDefaultLayout"
    xmlns:start="http://schemas.microsoft.com/Start/2014/StartLayout"
    xmlns:taskbar="http://schemas.microsoft.com/Start/2014/TaskbarLayout"
    Version="1">
  <CustomTaskbarLayoutCollection PinListPlacement="Replace">
    <defaultlayout:TaskbarLayout>
      <taskbar:TaskbarPinList>
'@
$xml = $xml + "`r`n" + ($pins -join "`r`n") + "`r`n" + @'
      </taskbar:TaskbarPinList>
    </defaultlayout:TaskbarLayout>
  </CustomTaskbarLayoutCollection>
</LayoutModificationTemplate>
'@

# write the file only when it changed
$dir = Join-Path $env:ProgramData 'dotfiles'
$file = Join-Path $dir 'TaskbarLayout.xml'
New-Item -ItemType Directory -Force -Path $dir | Out-Null
$current = $null
if (Test-Path -LiteralPath $file) { $current = [IO.File]::ReadAllText($file) }
$changed = ($current -ne $xml)
if ($changed) {
    [IO.File]::WriteAllText($file, $xml, (New-Object Text.UTF8Encoding($false)))
    Write-Step "set  $file"
} else {
    Write-Step "ok   $file"
}

# point the Start layout policy at it
$policy = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\Explorer'
$moved = Set-RegValue $policy 'StartLayoutFile' $file 'ExpandString'
Set-RegValue $policy 'LockedStartLayout' 1 | Out-Null
if ($changed -or $moved) {
    Write-Warning 'The taskbar changes at the next sign-in (sign out and back in).'
}
