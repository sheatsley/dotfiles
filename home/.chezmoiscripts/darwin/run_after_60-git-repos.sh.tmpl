#!/usr/bin/env bash
{{ template "sh-prelude.sh" . }}

# This script clones or pulls the git repos listed in ~/.config/git/repos (the
# git_repos task of the yadm bootstrap) into ~/repos. The list is encrypted in
# the source state and decrypted by chezmoi (it used to be a git-crypt file).
# Each non-comment line is a host prefix and a repo path:
#
#     github:sheatsley/attacks
#     gitea:sheatsley/private-project
#
# The prefixes map to github -> git@github.com:{path}.git and
# gitea -> git@{GITEA_HOST}:{path}.git (GITEA_HOST defaults to gitea.lan).
# Blank lines and lines starting with # are ignored. A repo that ships its own
# git hooks in a .githooks directory (the homelab repo does, for its checks
# before a commit) is pointed at them with core.hooksPath, since git never
# turns on hooks from a clone by itself; the list holds only your own repos, so
# their hooks are your own code. A repo that fails does not
# stop the others; the script fails at the end if any did, so the next apply
# retries. The list must not contain the dotfiles repo itself, which lives in
# ~/repos/chezmoi.
directory="$HOME/repos"
repos="$HOME/.config/git/repos"
gitea_host="${GITEA_HOST:-gitea.lan}"

# skip (without failing) until the encrypted list has been added to the repo
if [[ ! -f "$repos" ]]; then
  log "WARNING: $repos does not exist; skipping (see README, 'Migrating from yadm')"
  exit 0
fi
mkdir -p "$directory"

failed=0
while IFS= read -r line || [[ -n "$line" ]]; do
  # trim surrounding whitespace and skip blank lines and comments
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  if [[ -z "$line" || "$line" == \#* ]]; then
    continue
  fi

  # parse "host:owner/name"
  if [[ "$line" != *:* ]]; then
    log "WARNING: skipping malformed entry (expected host:owner/repo): $line"
    continue
  fi
  host="$(printf '%s' "${line%%:*}" | tr '[:upper:]' '[:lower:]')"
  path="${line#*:}"
  case "$host" in
    github) remote="git@github.com:${path}.git" ;;
    gitea) remote="git@${gitea_host}:${path}.git" ;;
    *)
      log "WARNING: skipping unknown host '$host' in entry: $line (known: github, gitea)"
      continue
      ;;
  esac

  # clone the repo, or pull it if it is already there
  name="${path##*/}"
  dest="$directory/$name"
  if [[ -d "$dest" ]]; then
    log "pulling $name"
    git -C "$dest" pull || { log "ERROR: could not pull $name"; failed=1; }
  else
    log "cloning $name from $host"
    git clone "$remote" "$dest" || { log "ERROR: could not clone $name"; failed=1; continue; }
  fi

  # use the repo's own hooks when it ships them
  if [[ -d "$dest/.githooks" && "$(git -C "$dest" config --get core.hooksPath || true)" != ".githooks" ]]; then
    git -C "$dest" config core.hooksPath .githooks || { log "ERROR: could not turn on the hooks of $name"; failed=1; continue; }
    log "set  $name uses its .githooks"
  fi
done < "$repos"

[[ "$failed" -eq 0 ]] || die "one or more repos failed (see above)"
