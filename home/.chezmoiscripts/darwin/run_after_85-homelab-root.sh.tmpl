#!/usr/bin/env bash
{{ template "sh-prelude.sh" . }}

# This script makes macOS trust the homelab's root certificate, so that Safari
# accepts the .lan services (the Proxmox web UI, Sunshine, and so on) without a
# warning. The root is ~/.config/homelab/root_ca.crt, which chezmoi decrypts
# from the repo (import-homelab-root puts it there); without it, as on a
# machine set up with DOTFILES_NO_YUBIKEY=1, nothing happens. Trust is checked
# first, so once the root is trusted nothing changes and no password is asked
# for; otherwise the root is added to the System keychain as a trusted root,
# which takes sudo, and macOS may also ask for your password or Touch ID to
# change the trust settings. After a root rotation, the previous root is then
# removed (its trust setting and the certificate itself), so a key that may
# have leaked can no longer vouch for anything. Only self-signed certificates
# with exactly the same name as the current root are removed, and only after
# the current root is trusted, so there is never a moment with no homelab
# root. SECURITY names the tool and exists only so that the tests can replace
# it.
sec="${SECURITY:-/usr/bin/security}"
keychain=/Library/Keychains/System.keychain
cert="$HOME/.config/homelab/root_ca.crt"

# nothing to trust yet
if [[ ! -s "$cert" ]]; then
  log "ok   no homelab root at ~/.config/homelab/root_ca.crt; skipped"
  exit 0
fi

# the root's name and SHA-256 fingerprint, in the form security prints them
cn="$(openssl x509 -in "$cert" -noout -subject -nameopt multiline | sed -n 's/^ *commonName *= *//p')"
fp="$(openssl x509 -in "$cert" -noout -fingerprint -sha256 | cut -d= -f2 | tr -d ':' | tr '[:lower:]' '[:upper:]')"

# trust the root unless macOS already does, then check rather than assume
if "$sec" verify-cert -c "$cert" >/dev/null 2>&1; then
  log "ok   homelab root is trusted ($cn)"
else
  log "set  trusting the homelab root ($cn, SHA-256 $fp); macOS may ask for your password"
  sudo "$sec" add-trusted-cert -d -r trustRoot -k "$keychain" "$cert"
  "$sec" verify-cert -c "$cert" >/dev/null 2>&1 || die "macOS still does not trust $cert after add-trusted-cert"
  log "set  homelab root trusted"
fi

# remove previous roots: self-signed certificates with the same name but a different fingerprint
if [[ -n "$cn" ]]; then
  work="$(mktemp -d)"
  trap 'rm -rf "$work"' EXIT
  "$sec" find-certificate -a -c "$cn" -p "$keychain" 2>/dev/null \
    | awk -v dir="$work" '/-----BEGIN CERTIFICATE-----/ { n++ } n { print > (dir "/" n ".pem") }' || true
  for pem in "$work"/*.pem; do
    [[ -e "$pem" ]] || continue
    other_cn="$(openssl x509 -in "$pem" -noout -subject -nameopt multiline | sed -n 's/^ *commonName *= *//p')"
    other_fp="$(openssl x509 -in "$pem" -noout -fingerprint -sha256 | cut -d= -f2 | tr -d ':' | tr '[:lower:]' '[:upper:]')"
    subject="$(openssl x509 -in "$pem" -noout -subject)"
    issuer="$(openssl x509 -in "$pem" -noout -issuer)"
    [[ "$other_cn" == "$cn" && "$other_fp" != "$fp" && "${subject#subject=}" == "${issuer#issuer=}" ]] || continue
    sha1="$(openssl x509 -in "$pem" -noout -fingerprint -sha1 | cut -d= -f2 | tr -d ':')"
    sudo "$sec" remove-trusted-cert -d "$pem" || true
    sudo "$sec" delete-certificate -Z "$sha1" "$keychain" || die "could not remove the previous homelab root (SHA-256 $other_fp)"
    log "set  removed the previous homelab root (SHA-256 $other_fp)"
  done
fi
