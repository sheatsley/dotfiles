#!/bin/sh
#
# This script sets the macOS defaults (trackpad, dock, finder, safari, key
# repeat, and so on; the macos_defaults task of the yadm bootstrap). chezmoi runs
# it whenever its contents change (run_onchange), which replaces the sentinel
# file the yadm bootstrap wrote: to apply a new default, add it here and run
# `chezmoi apply`. The commands below are those of ~/.config/macos/defaults; the
# Dock apps come from .chezmoidata/macos.yaml, one command each. A command that
# fails is reported at the end and makes the script fail, so that the next apply
# runs it again. The trackpad settings are written
# for both the built-in trackpad and Bluetooth ones (a Magic Trackpad), which use
# different domains, and take effect after logging out and back in. The Firefox
# lines are enterprise policies, which Firefox locks (it shows that it is
# "managed by your organization").
failed=0
defaults() {
  command defaults "$@" || failed=1
}
defaults write com.apple.AppleMultitouchTrackpad Clicking -int 1                               # enable tap to click for trackpads
defaults write com.apple.AppleMultitouchTrackpad FirstClickThreshold -int 0                    # low pressure for force click
defaults write com.apple.AppleMultitouchTrackpad SecondClickThreshold -int 0                   # low pressure for second click
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -int 1                # enable three finger drag for trackpads
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerTapGesture -int 2          # enable look up with three fingers
defaults write com.apple.desktopservices DSDontWriteNetworkStores -int 1                       # do not create .ds_store files on network volumes
defaults write com.apple.dock expose-group-apps -int 1                                         # group windows by application in exposé
defaults write com.apple.dock mru-spaces -int 0                                                # do not automatically rearrange spaces
defaults write com.apple.dock orientation left                                                 # place dock on the left
defaults write com.apple.dock persistent-apps -array                                           # clear the dock
{{ range .macos.dock_apps -}}
defaults write com.apple.dock persistent-apps -array-add '<dict><key>tile-data</key><dict><key>file-data</key><dict><key>_CFURLString</key><string>{{ .path }}</string><key>_CFURLStringType</key><integer>0</integer></dict></dict></dict>'  # add {{ .name }} to the dock
{{ end -}}
defaults write com.apple.dock show-recents -int 0                                              # do not show recent apps in dock
defaults write com.apple.dock size-immutable -int 1                                            # disable dock resizing
defaults write com.apple.dock tilesize -int 31                                                 # set dock icons to 31 pixels
defaults write com.apple.dock wvous-br-corner -int 0                                           # disable bottom-right hot corner
defaults write com.apple.dock workspaces-auto-swoosh -int 0                                    # disable auto space switching
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -int 1              # bluetooth trackpads: enable tap to click
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad FirstClickThreshold -int 0   # bluetooth trackpads: low pressure for force click
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad SecondClickThreshold -int 0  # bluetooth trackpads: low pressure for second click
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerDrag -int 1# bluetooth trackpads: enable three finger drag
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerTapGesture -int 2# bluetooth trackpads: enable look up with three fingers
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"                            # search the current folder by default in finder
defaults write com.apple.finder FXEnableExtensionChangeWarning -int 0                          # disable file extension change warning
defaults write com.apple.finder FXPreferredViewStyle "Nlsv"                                    # set default view style in finder to list view
defaults write com.apple.finder ShowPathbar -int 1                                             # show path in finder
defaults write com.apple.HIToolbox AppleDictationAutoEnable -int 0                             # disable dictation via keyboard shortcuts
defaults -currentHost write com.apple.screensaver idleTime -int 300                            # start the screen saver after 5 minutes
defaults write com.apple.TimeMachine DoNotOfferNewDisksForBackup -int 1                        # do not use new hard drives as backup volumes
defaults write com.apple.WindowManager GloballyEnabled -bool true                            # enable stage manager
defaults write NSGlobalDomain ApplePressAndHoldEnabled -int 0                                  # disable press-and-hold accent popup (ensures key repeat works everywhere)
defaults write NSGlobalDomain AppleShowAllExtensions -int 1                                    # show filename extensions in finder
defaults write NSGlobalDomain AppleWindowTabbingMode "always"                                  # always prefer tabs when opening documents
defaults write NSGlobalDomain com.apple.trackpad.scaling -int 2                                # set faster tracking speed
defaults write NSGlobalDomain InitialKeyRepeat -int 15                                         # use a very short delay before key repeat starts
defaults write NSGlobalDomain KeyRepeat -int 2                                                 # use fast keyboard repeat rate
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -int 1                        # expand the save panel by default
defaults write NSGlobalDomain NSQuitAlwaysKeepsWindows -int 1                                  # restore windows when opening apps
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -int 1                           # expand the print menu by default
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -int 1                          # expand the print menu by default, part 2
defaults write org.mozilla.firefox EnterprisePoliciesEnabled -bool TRUE                        # let firefox read the policies below
defaults write org.mozilla.firefox DontCheckDefaultBrowser -bool TRUE                          # firefox: do not check if it is the default browser
defaults write org.mozilla.firefox OfferToSaveLogins -bool FALSE                               # firefox: do not ask to save passwords
for APP in Dock Finder SystemUIServer; do killall "${APP}" 2>/dev/null || true; done    # kill affected applications
if [ "$failed" -ne 0 ]; then
  echo "ERROR: some defaults could not be written (see the messages above); apply again after fixing the cause." >&2
  exit 1
fi
