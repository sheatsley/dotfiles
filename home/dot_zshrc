export GPG_TTY="$(tty)"                                      # set tty device for current shell
export SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket) # set ssh agent socket
gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1      # refresh agent tty
ENABLE_CORRECTION="true"                                     # enable command auto-correction
alias brew-sync="$HOME/repos/chezmoi/brew-sync"              # add hand-installed brew packages to packages.yaml
