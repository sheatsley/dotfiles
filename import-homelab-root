#!/usr/bin/env bash
# This script brings a homelab root certificate into the dotfiles, for the
# homelab's bin/init-root (after it creates or rotates the root) or for running
# by hand. It copies the certificate to home/dot_config/homelab/root_ca.crt in
# this repo, unencrypted: a root certificate is public by design, and the
# signed commit is what vouches for it. Every apply then puts it at
# ~/.config/homelab/root_ca.crt, where the Mac trusts it in the System keychain
# (run_after_85-homelab-root) and Windows in its machine-wide root store
# (run_after_12-homelab-root), each removing the previous root after a
# rotation; Windows also uses it to request Sunshine's certificate. It does
# not commit; it prints the signed commit to run. It is safe to rerun: when the
# repo already holds this certificate, it says so and changes nothing. It runs
# with the bash that ships with macOS (3.2), and needs openssl.
#
# usage: import-homelab-root <path-to-root_ca.crt>
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIR="$REPO/home/dot_config/homelab"
DEST="$DIR/root_ca.crt"

log() {
  # This function prints a progress line.
  #
  # :param $*: the text to print
  # :return: None
  printf '%s\n' "$*"
}

die() {
  # This function prints an error to stderr and exits with status 1.
  #
  # :param $*: the message to print
  # :return: does not return
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

# check the argument: a readable certificate that is a self-signed CA
[[ $# -eq 1 ]] || die "usage: import-homelab-root <path-to-root_ca.crt>"
src="$1"
[[ -f "$src" ]] || die "$src does not exist"
openssl x509 -in "$src" -noout >/dev/null 2>&1 || die "$src is not a PEM certificate"
openssl x509 -in "$src" -noout -text | grep -q 'CA:TRUE' || die "$src is not a CA certificate"
subject="$(openssl x509 -in "$src" -noout -subject)"
issuer="$(openssl x509 -in "$src" -noout -issuer)"
[[ "${subject#subject=}" == "${issuer#issuer=}" ]] || die "$src is not self-signed, so it is not a root"
fp="$(openssl x509 -in "$src" -noout -fingerprint -sha256 | cut -d= -f2 | tr -d ':' | tr 'A-F' 'a-f')"

# nothing to do if the repo already holds exactly this certificate
if [[ -f "$DEST" ]] && cmp -s "$src" "$DEST"; then
  log "ok   the dotfiles already hold this root (SHA-256 $fp); nothing changed"
  exit 0
fi

# copy it in
mkdir -p "$DIR"
cp "$src" "$DEST"
chmod 0644 "$DEST"
log "set  copied the root to home/dot_config/homelab/root_ca.crt (SHA-256 $fp)"

# the commit is left to you, since it must be signed
log ""
log "Review and commit (signed):"
log "  git -C \"$REPO\" add home/dot_config/homelab/root_ca.crt"
log "  git -C \"$REPO\" commit -S -m \"Update the homelab root\""
log "Then run chezmoi apply on each Mac and on Windows (each trusts the new root and removes the old one)."
